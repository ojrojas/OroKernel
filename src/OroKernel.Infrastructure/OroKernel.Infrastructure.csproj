<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OroKernel.Infrastructure</RootNamespace>

    <!-- NuGet Package Metadata -->
    <PackageId>OroKernel.Infrastructure</PackageId>
    <Version>1.0.0</Version>
    <Authors>Oscar Rojas</Authors>
    <Company>Oscar Rojas</Company>
    <Description>Infrastructure layer for OroKernel: EF Core auditable DbContext, audit entries, identity client services, and HTTP retry handlers. Depends on OroKernel.Domain.</Description>
    <PackageTags>Kernel;DDD;Infrastructure;EntityFrameworkCore;.NET</PackageTags>
    <RepositoryUrl>https://github.com/ojrojas/OroKernel</RepositoryUrl>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ojrojas/OroKernel</PackageProjectUrl>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OroKernel.Domain\OroKernel.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
